<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Dokumente und lokale SQLite-Datenbank verlassen niemals unverschlüsselt das Gerät -->
        <exclude domain="file" path="Documents" />
        <exclude domain="file" path="Scans" />
        <exclude domain="file" path="Backups" />
        <exclude domain="database" path="mydocanizer_database" />
        <exclude domain="database" path="mydocanizer_database-shm" />
        <exclude domain="database" path="mydocanizer_database-wal" />
        <include domain="sharedpref" path="mydocanizer_prefs.xml" />
        <include domain="sharedpref" path="doc_rules_storage.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Bei direktem Gerät-zu-Gerät Umzug (z.B. Kabel/WiFi-Direct) Transfer erlauben -->
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
